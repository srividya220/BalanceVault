# BalanceVault Global Environment Configuration
# Copy this file to backend/.env and customize for your deployment

# Server Configuration
PORT=8080
NODE_ENV=production

# Database Connection (PostgreSQL 17)
DATABASE_URL="postgresql://postgres:vault_db_password_2026@localhost:5432/balancevault?schema=public"

# Authentication & JWT
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-32-bytes"
JWT_EXPIRES_IN="24h"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=15

# Initial Admin Bootstrap Credentials
ADMIN_EMAIL="admin@balancevault.com"
ADMIN_PASSWORD="ChooseStrongAdminPassword!"
ADMIN_FULL_NAME="System Administrator"

# Central System Reserve Vault Account Identifier
SYSTEM_RESERVE_ACCOUNT_NUMBER="BV-SYS-RESERVE-001"
