# BalanceVault Environment Configuration Template
PORT=8080
NODE_ENV=production
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/balancevault?schema=public"
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret"
JWT_EXPIRES_IN="24h"
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=15
ADMIN_EMAIL="admin@balancevault.com"
ADMIN_PASSWORD="ChooseStrongAdminPassword!"
ADMIN_FULL_NAME="System Administrator"
SYSTEM_RESERVE_ACCOUNT_NUMBER="BV-SYS-RESERVE-001"
